# Copy to .env.local for local development (never commit secrets).
# Also set these in Vercel → Project → Settings → Environment Variables.

# YouTube Data API v3 key (server-only) — used for channel search only; video feeds use RSS
YOUTUBE_API_KEY=

# Fine-grained GitHub PAT with Contents read/write on this repo only
GITHUB_TOKEN=

# owner/repo — e.g. alesanchezr/youtube-for-kids
GITHUB_REPO=alesanchezr/youtube-for-kids

# Parent PIN checked server-side on manage APIs (exactly 4 digits)
ADMIN_PIN=
